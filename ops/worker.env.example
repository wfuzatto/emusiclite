# Copie para /etc/musiclite/worker.env com modo 600. Não reutilize segredos do eBookLite.
MUSIC_DB_HOST=db.example.invalid
MUSIC_DB_PORT=3306
MUSIC_DB_NAME=emusic_lite
MUSIC_DB_USER=musiclite_worker
MUSIC_DB_PASSWORD=CHANGE_ME
MUSIC_AI_ENABLED=true
MUSIC_AI_TIMEZONE=America/Sao_Paulo
MUSIC_AI_OLLAMA_URL=http://127.0.0.1:11434
MUSIC_AI_OLLAMA_MODEL=CHANGE_AFTER_INVENTORY
MUSIC_AI_OLLAMA_KEEP_ALIVE=0
MUSIC_AI_GENERATOR_BACKEND=http
MUSIC_AI_GENERATOR_URL=http://127.0.0.1:8091
MUSIC_AI_GENERATOR_PORT=8091
MUSIC_AI_GENERATOR_TOKEN=CHANGE_TO_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
MUSIC_AI_GENERATOR_TIMEOUT=1800
MUSIC_AI_GENERATOR_OUTPUT_PATH=/var/lib/musiclite/generator-output
MUSIC_AI_GENERATOR_MAX_DURATION=180
MUSIC_AI_GENERATOR_STEPS=8
MUSIC_AI_GENERATOR_QUANTIZATION=auto
MUSIC_AI_GENERATOR_DCW_ENABLED=auto
MUSIC_AI_GENERATOR_VELOCITY_NORM_THRESHOLD=auto
MUSIC_AI_GENERATOR_CHECKPOINTS_DIR=/var/lib/musiclite/models
MUSIC_AI_NEURAL_STEPS=12
MUSIC_AI_NEURAL_MAX_CANDIDATES=4
MUSIC_AI_NEURAL_SOURCE_ROOTS=/var/lib/musiclite/studio-hq/output:/var/lib/musiclite/neural-studio
MUSICLITE_NEURAL_GENERATOR_URL=http://127.0.0.1:8091
MUSICLITE_NEURAL_TIMEOUT=5400
MUSIC_AI_COMFYUI_URL=http://127.0.0.1:8188
MUSIC_AI_COMFYUI_WORKFLOW=/opt/musiclite/config/comfy-cover-workflow.json
MUSIC_AI_COMFYUI_CHECKPOINT=CHANGE_AFTER_INVENTORY
MUSIC_AI_STORAGE_PATH=/var/lib/musiclite
MUSIC_AI_INGEST_URL=https://music.example.invalid
MUSIC_AI_INGEST_SECRET=CHANGE_TO_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
MUSIC_AI_INGEST_CA_FILE=
MUSIC_AI_FFPROBE_BIN=/usr/bin/ffprobe
MUSIC_AI_MIN_FREE_VRAM_MB=5200
MUSIC_AI_EBOOK_DB_HOST=ebook-db.example.invalid
MUSIC_AI_EBOOK_DB_PORT=3306
MUSIC_AI_EBOOK_DB_NAME=ebooklite
MUSIC_AI_EBOOK_DB_USER=musiclite_guard
MUSIC_AI_EBOOK_DB_PASSWORD=replace-with-read-only-password
MUSIC_AI_WORKER_TIMEOUT_MINUTES=20
