# Configuração PHP/Locaweb. Defina no painel/servidor; este arquivo não contém segredos reais.
MUSIC_DB_HOST=localhost
MUSIC_DB_PORT=3306
MUSIC_DB_NAME=emusic_lite
MUSIC_DB_USER=CHANGE_ME
MUSIC_DB_PASSWORD=CHANGE_ME
MUSIC_AUTH_SUBJECT_KEY=CHANGE_TO_RANDOM_SECRET
MUSIC_AI_ADMIN_USER_IDS=CHANGE_AFTER_FIRST_LOGIN
MUSIC_AI_PUBLIC_MEDIA_PATH=/absolute/private-or-protected/path/music-ai
MUSIC_AI_INGEST_SECRET=CHANGE_TO_A_DIFFERENT_RANDOM_SECRET_WITH_32_OR_MORE_CHARS
MUSIC_AI_INGEST_MAX_SKEW=300
MUSIC_AI_TRUST_PROXY_HTTPS=false
MUSIC_AI_MAX_AUDIO_MB=100
MUSIC_AI_MAX_COVER_MB=15
MUSIC_AI_FFPROBE_BIN=/usr/bin/ffprobe
